# Twins Frontend Environment Configuration
#
# There is NO sample data. Without a backend every page says so and shows nothing.
#
# The browser never talks to the backend directly. A server-side proxy (src/app/api/twins) forwards GET requests on an allow-list, using a token that stays on the server.
# Server-only (do NOT prefix with NEXT_PUBLIC_):
TWINS_API_URL=http://127.0.0.1:4400
TWINS_API_KEY=
#
# Staging's API listens on the VPS loopback only. Open a tunnel first:
#   ssh -L 4400:127.0.0.1:4110 hostinger-vps
