# Twins Frontend Environment Configuration
#
# MOCK MODE (default): leave everything blank. Every page shows clearly-labelled sample data.
#
# LIVE MODE (read-only): the browser never talks to the backend directly. A server-side proxy (src/app/api/twins) forwards
# GET requests on an allow-list, using a token that stays on the server.
NEXT_PUBLIC_TWINS_LIVE=
# Server-only (do NOT prefix with NEXT_PUBLIC_):
TWINS_API_URL=
TWINS_API_KEY=
